# The assistant's settings. Copy this file to `.env` beside it, on the winery
# computer only, and fill in the providers you want. `.env` is never committed.
# A provider with no key, or no model, is simply not offered.
#
# After changing this file the stack's functions need a restart to read it.

# Which provider a question goes to when the phone does not say.
AGENT_PROVIDER=anthropic

# Claude. The model defaults to claude-opus-5-5 when left blank.
ANTHROPIC_API_KEY=
AGENT_ANTHROPIC_MODEL=

# ChatGPT. Put the model name from OpenAI's model list.
OPENAI_API_KEY=
AGENT_OPENAI_MODEL=
# AGENT_OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek and Kimi speak the same protocol as OpenAI. Their address and model
# name come from each one's own API documentation; check them there rather
# than trusting a copy here.
DEEPSEEK_API_KEY=
AGENT_DEEPSEEK_MODEL=
AGENT_DEEPSEEK_BASE_URL=

KIMI_API_KEY=
AGENT_KIMI_MODEL=
AGENT_KIMI_BASE_URL=
