# Copy to .env.local and fill in from `supabase status` (local) or the project
# API settings (hosted). .env.local is gitignored; never commit a filled copy.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Practice mode, optional. A second stack with nothing real in it, where
# resetting and deleting are allowed. `bun run practice start` brings it up and
# prints these two values; `bun run practice seed` copies the cellar into it.
# Leave both blank and the app never offers practice mode at all.
VITE_PRACTICE_URL=
VITE_PRACTICE_ANON_KEY=
