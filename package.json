{
  "name": "vsv-management-software",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:reset": "supabase db reset",
    "doctor": "echo 'doctor: not implemented. See sorry S-4 in docs/sorry-ledger.md. event.subject_id is not a foreign key, so nothing currently checks for orphaned subjects.' && exit 1",
    "db:test": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f tests/schema_assertions.sql",
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "typescript": "^5.9.3"
  }
}
